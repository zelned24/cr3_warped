/* Crash Bandicoot: Warped (PSX) -> 3DS port - level data handling.
 *
 * The level geometry is decoded on the host (tools/export_levels.py) out of
 * Naughty Dog's NSF archives and stored in a compact blob that is embedded
 * into the .3dsx:
 *
 *   'CBW3' u32 id, u32 modelCount, u32 paletteCount, u32 reserved
 *   per model:
 *       i32 originX, originY, originZ      (cm)
 *       u32 vcount, tcount, qcount
 *       vertices : i16 x, i16 y, i16 z, u16 colourIndex
 *       triangles: u16 a, u16 b, u16 c, u16 flags
 *       quads    : u16 a, u16 b, u16 c, u16 d, u16 flags
 *   palette   : u8 r, u8 g, u8 b, u8 pad
 *
 * A level is made of a number of "world models" (zones).  Only the zone the
 * player is currently in is decoded into VRAM, which keeps the memory
 * footprint small enough for the original 3DS.
 */
#include <stdlib.h>
#include <string.h>
#include <stdio.h>
#include <3ds.h>
#include <citro3d.h>

#include "level.h"
#include "levels_bin.h"

#define HEIGHT_CELL   32.0f   /* cm per heightmap cell */
#define MAX_MODELS    160

static const uint8_t *s_blob = (const uint8_t *)levels_bin;
static uint32_t s_blob_size = levels_bin_size;

/* ------------------------------------------------------------------ */
/* blob directory                                                      */
/* ------------------------------------------------------------------ */

typedef struct {
    uint32_t id;
    uint32_t offset;
    uint32_t size;
} blob_entry;

static blob_entry s_entries[64];
static int s_entry_count;

static void parse_blob(void)
{
    if (s_entry_count)
        return;
    if (s_blob_size < 16 || memcmp(s_blob, "CBWB", 4) != 0)
        return;
    uint32_t count = *(const uint32_t *)(s_blob + 8);
    if (count > 64)
        count = 64;
    for (uint32_t i = 0; i < count; i++) {
        const uint32_t *p = (const uint32_t *)(s_blob + 16 + i * 12);
        s_entries[i].id     = p[0];
        s_entries[i].offset = p[1];
        s_entries[i].size   = p[2];
    }
    s_entry_count = (int)count;
}

int level_count(void)
{
    parse_blob();
    return s_entry_count;
}

const level_info *level_get(int index)
{
    static level_info info;
    parse_blob();
    if (index < 0 || index >= s_entry_count)
        return NULL;
    info.id   = s_entries[index].id;
    info.data = s_blob + s_entries[index].offset;
    info.size = s_entries[index].size;
    return &info;
}

int level_find(uint32_t id)
{
    parse_blob();
    for (int i = 0; i < s_entry_count; i++)
        if (s_entries[i].id == id)
            return i;
    return -1;
}

/* ------------------------------------------------------------------ */
/* level state                                                         */
/* ------------------------------------------------------------------ */

static const uint8_t *s_level;       /* current level blob                  */
static const uint8_t *s_palette;
static uint32_t s_palette_n;

typedef struct {
    uint32_t offset;                 /* record offset inside the blob */
    uint32_t vcount, tcount, qcount;
    float ox, oy, oz;                /* origin, cm                     */
    float minx, miny, minz;
    float maxx, maxy, maxz;
} model_rec;

static model_rec s_models[MAX_MODELS];
static int s_model_count;

static level_vertex *s_vbo;          /* decoded zone, in VRAM              */
static uint32_t s_vbo_verts;

static int32_t *s_hmap;              /* height map of the current zone      */
static int s_hw, s_hh;
static float s_hx0, s_hz0;

static int s_zone = -1;
static int s_zone_switches = 0;
static int s_alloc_fail = 0;

/* ------------------------------------------------------------------ */

static float decode_axis(int16_t v)
{
    return (float)v / 16.0f;   /* 1/16 of a world unit (cm) */
}

static void model_scan(model_rec *m, const uint8_t *mp)
{
    m->offset = (uint32_t)(mp - s_level);
    m->ox = (float)*(const int32_t *)(mp + 0);
    m->oy = (float)*(const int32_t *)(mp + 4);
    m->oz = (float)*(const int32_t *)(mp + 8);
    m->vcount = *(const uint32_t *)(mp + 12);
    m->tcount = *(const uint32_t *)(mp + 16);
    m->qcount = *(const uint32_t *)(mp + 20);
    m->minx = m->miny = m->minz = 1e30f;
    m->maxx = m->maxy = m->maxz = -1e30f;

    const uint8_t *v = mp + 24;
    for (uint32_t i = 0; i < m->vcount; i++) {
        int16_t x = *(const int16_t *)(v + i * 8 + 0);
        int16_t y = *(const int16_t *)(v + i * 8 + 2);
        int16_t z = *(const int16_t *)(v + i * 8 + 4);
        float wx = m->ox + decode_axis(x);
        float wy = m->oy + decode_axis(y);
        float wz = m->oz + decode_axis(z);
        if (wx < m->minx) m->minx = wx;
        if (wy < m->miny) m->miny = wy;
        if (wz < m->minz) m->minz = wz;
        if (wx > m->maxx) m->maxx = wx;
        if (wy > m->maxy) m->maxy = wy;
        if (wz > m->maxz) m->maxz = wz;
    }
}

static void height_put(float x, float z, float y)
{
    int ix = (int)((x - s_hx0) / HEIGHT_CELL);
    int iz = (int)((z - s_hz0) / HEIGHT_CELL);
    if (ix < 0 || iz < 0 || ix >= s_hw || iz >= s_hh)
        return;
    int32_t *cell = &s_hmap[iz * s_hw + ix];
    if (*cell == INT32_MIN || y > (float)*cell)
        *cell = (int32_t)y;
}

static void height_tri(float ax, float ay, float az,
                       float bx, float by, float bz,
                       float cx, float cy, float cz)
{
    if (!s_hmap)
        return;
    float minx = ax < bx ? (ax < cx ? ax : cx) : (bx < cx ? bx : cx);
    float maxx = ax > bx ? (ax > cx ? ax : cx) : (bx > cx ? bx : cx);
    float minz = az < bz ? (az < cz ? az : cz) : (bz < cz ? bz : cz);
    float maxz = az > bz ? (az > cz ? az : cz) : (bz > cz ? bz : cz);

    int ix0 = (int)((minx - s_hx0) / HEIGHT_CELL);
    int ix1 = (int)((maxx - s_hx0) / HEIGHT_CELL);
    int iz0 = (int)((minz - s_hz0) / HEIGHT_CELL);
    int iz1 = (int)((maxz - s_hz0) / HEIGHT_CELL);
    if (ix0 < 0) ix0 = 0;
    if (iz0 < 0) iz0 = 0;
    if (ix1 >= s_hw) ix1 = s_hw - 1;
    if (iz1 >= s_hh) iz1 = s_hh - 1;

    float d = (by - ay) * (cz - az) - (bz - az) * (cy - ay);
    if (d > -1e-4f && d < 1e-4f)
        return;
    float inv = 1.0f / d;

    for (int iz = iz0; iz <= iz1; iz++) {
        for (int ix = ix0; ix <= ix1; ix++) {
            float px = s_hx0 + (ix + 0.5f) * HEIGHT_CELL;
            float pz = s_hz0 + (iz + 0.5f) * HEIGHT_CELL;
            float w0 = ((bx - ax) * (pz - az) - (bz - az) * (px - ax)) * inv;
            float w1 = ((cx - bx) * (pz - bz) - (cz - bz) * (px - bx)) * inv;
            float w2 = 1.0f - w0 - w1;
            if (w0 < -0.001f || w1 < -0.001f || w2 < -0.001f)
                continue;
            height_put(px, pz, ay * w2 + by * w1 + cz * w0);
        }
    }
}

/* Decode one zone into VRAM and build its height map. */
static int zone_build(int index)
{
    if (index < 0 || index >= s_model_count)
        return -1;
    const model_rec *m = &s_models[index];

    if (s_vbo) { linearFree(s_vbo); s_vbo = NULL; }
    if (s_hmap) { linearFree(s_hmap); s_hmap = NULL; }
    s_vbo_verts = 0;
    s_hw = s_hh = 0;

    uint32_t verts = m->tcount * 3 + m->qcount * 6;
    if (verts == 0)
        return -1;
    s_vbo = (level_vertex *)linearAlloc(verts * sizeof(level_vertex));
    if (!s_vbo) { s_alloc_fail++; return -1; }

    /* height map for this zone only */
    float w = m->maxx - m->minx, d = m->maxz - m->minz;
    s_hw = (int)(w / HEIGHT_CELL) + 2;
    s_hh = (int)(d / HEIGHT_CELL) + 2;
    if (s_hw < 1) s_hw = 1;
    if (s_hh < 1) s_hh = 1;
    if ((int64_t)s_hw * s_hh > 4 * 1024 * 1024) {
        /* safety: keep the map bounded */
        s_hw = s_hh = 1024;
    }
    s_hx0 = m->minx - HEIGHT_CELL;
    s_hz0 = m->minz - HEIGHT_CELL;
    s_hmap = (int32_t *)linearAlloc(sizeof(int32_t) * s_hw * s_hh);
    if (s_hmap)
        for (int i = 0; i < s_hw * s_hh; i++)
            s_hmap[i] = INT32_MIN;

    const uint8_t *mp = s_level + m->offset;
    const uint8_t *vdata = mp + 24;
    const uint8_t *tdata = vdata + m->vcount * 8;
    const uint8_t *qdata = tdata + m->tcount * 8;

    uint32_t n = 0;
    level_vertex *out = s_vbo;

    /* triangles */
    for (uint32_t i = 0; i < m->tcount; i++) {
        uint16_t idx[3];
        for (int k = 0; k < 3; k++)
            idx[k] = *(const uint16_t *)(tdata + i * 8 + k * 2);
        if (idx[0] >= m->vcount || idx[1] >= m->vcount || idx[2] >= m->vcount)
            continue;
        float px[3], py[3], pz[3];
        for (int k = 0; k < 3; k++) {
            const uint8_t *vp = vdata + idx[k] * 8;
            px[k] = m->ox + decode_axis(*(const int16_t *)(vp + 0));
            py[k] = m->oy + decode_axis(*(const int16_t *)(vp + 2));
            pz[k] = m->oz + decode_axis(*(const int16_t *)(vp + 4));
            uint16_t ci = *(const uint16_t *)(vp + 6);
            if (ci >= s_palette_n)
                ci = 0;
            out[n].x = px[k]; out[n].y = py[k]; out[n].z = pz[k];
            out[n].r = s_palette[ci * 4 + 0] / 255.0f;
            out[n].g = s_palette[ci * 4 + 1] / 255.0f;
            out[n].b = s_palette[ci * 4 + 2] / 255.0f;
            n++;
        }
        height_tri(px[0], py[0], pz[0], px[1], py[1], pz[1], px[2], py[2], pz[2]);
    }

    /* quads -> two triangles */
    for (uint32_t i = 0; i < m->qcount; i++) {
        uint16_t idx[4];
        for (int k = 0; k < 4; k++)
            idx[k] = *(const uint16_t *)(qdata + i * 10 + k * 2);
        if (idx[0] >= m->vcount || idx[1] >= m->vcount ||
            idx[2] >= m->vcount || idx[3] >= m->vcount)
            continue;
        float px[4], py[4], pz[4];
        for (int k = 0; k < 4; k++) {
            const uint8_t *vp = vdata + idx[k] * 8;
            px[k] = m->ox + decode_axis(*(const int16_t *)(vp + 0));
            py[k] = m->oy + decode_axis(*(const int16_t *)(vp + 2));
            pz[k] = m->oz + decode_axis(*(const int16_t *)(vp + 4));
            uint16_t ci = *(const uint16_t *)(vp + 6);
            if (ci >= s_palette_n)
                ci = 0;
            out[n].x = px[k]; out[n].y = py[k]; out[n].z = pz[k];
            out[n].r = s_palette[ci * 4 + 0] / 255.0f;
            out[n].g = s_palette[ci * 4 + 1] / 255.0f;
            out[n].b = s_palette[ci * 4 + 2] / 255.0f;
            n++;
        }
        height_tri(px[0], py[0], pz[0], px[1], py[1], pz[1], px[2], py[2], pz[2]);
        height_tri(px[0], py[0], pz[0], px[2], py[2], pz[2], px[3], py[3], pz[3]);
    }

    s_vbo_verts = n;
    s_zone = index;
    s_zone_switches++;
    return 0;
}

int level_load(uint32_t id)
{
    int idx = level_find(id);
    if (idx < 0)
        return -1;
    const level_info *info = level_get(idx);
    if (!info || info->size < 16 || memcmp(info->data, "CBW3", 4) != 0)
        return -1;

    s_level = info->data;
    s_palette_n = *(const uint32_t *)(s_level + 12);
    s_palette = s_level + info->size - s_palette_n * 4;

    uint32_t model_count = *(const uint32_t *)(s_level + 8);
    if (model_count > MAX_MODELS)
        model_count = MAX_MODELS;

    s_model_count = 0;
    const uint8_t *mp = s_level + 20;
    for (uint32_t i = 0; i < model_count; i++) {
        model_rec *m = &s_models[s_model_count];
        model_scan(m, mp);
        s_model_count++;
        uint32_t vcount = m->vcount, tcount = m->tcount, qcount = m->qcount;
        mp += 24 + vcount * 8 + tcount * 8 + qcount * 10;
    }

    /* start in the busiest zone */
    int best = 0;
    uint32_t best_count = 0;
    for (int i = 0; i < s_model_count; i++) {
        uint32_t c = s_models[i].tcount * 3 + s_models[i].qcount * 6;
        if (c > best_count) { best_count = c; best = i; }
    }
    if (zone_build(best) != 0)
        return -1;
    return 0;
}

int level_activate_zone(int index)
{
    if (index < 0 || index >= s_model_count)
        return -1;
    if (index == s_zone)
        return 0;
    return zone_build(index);
}

void level_unload(void)
{
    if (s_vbo) { linearFree(s_vbo); s_vbo = NULL; }
    if (s_hmap) { linearFree(s_hmap); s_hmap = NULL; }
    s_vbo_verts = 0;
    s_model_count = 0;
    s_zone = -1;
    s_hw = s_hh = 0;
}

int level_vertex_count(void)
{
    return (int)s_vbo_verts;
}

const level_vertex *level_vertices(void)
{
    return s_vbo;
}

int level_model_count(void)
{
    return s_model_count;
}

const level_model_info *level_model(int index)
{
    static level_model_info info;
    if (index < 0 || index >= s_model_count)
        return NULL;
    const model_rec *m = &s_models[index];
    info.first = 0;
    info.count = m->tcount * 3 + m->qcount * 6;
    info.ox = m->ox; info.oy = m->oy; info.oz = m->oz;
    info.minx = m->minx; info.miny = m->miny; info.minz = m->minz;
    info.maxx = m->maxx; info.maxy = m->maxy; info.maxz = m->maxz;
    return &info;
}

int level_model_at(float x, float z)
{
    for (int i = 0; i < s_model_count; i++) {
        const model_rec *m = &s_models[i];
        if (x >= m->minx && x <= m->maxx && z >= m->minz && z <= m->maxz)
            return i;
    }
    return -1;
}

int level_height(float x, float z)
{
    if (!s_hmap)
        return -1000000;
    int ix = (int)((x - s_hx0) / HEIGHT_CELL);
    int iz = (int)((z - s_hz0) / HEIGHT_CELL);
    if (ix < 0 || iz < 0 || ix >= s_hw || iz >= s_hh)
        return -1000000;
    int32_t y = s_hmap[iz * s_hw + ix];
    if (y == INT32_MIN)
        return -1000000;
    return (int)y;
}

void level_bounds(float *minx, float *miny, float *minz,
                  float *maxx, float *maxy, float *maxz)
{
    *minx = *miny = *minz = 1e30f;
    *maxx = *maxy = *maxz = -1e30f;
    for (int i = 0; i < s_model_count; i++) {
        const model_rec *m = &s_models[i];
        if (m->minx < *minx) *minx = m->minx;
        if (m->miny < *miny) *miny = m->miny;
        if (m->minz < *minz) *minz = m->minz;
        if (m->maxx > *maxx) *maxx = m->maxx;
        if (m->maxy > *maxy) *maxy = m->maxy;
        if (m->maxz > *maxz) *maxz = m->maxz;
    }
}

/* The Crash level code letter, e.g. 0x0A -> 'a'. */
int level_debug(int what)
{
    switch (what) {
    case 0: return s_vbo ? 1 : 0;
    case 1: return (int)((uintptr_t)s_vbo & 0xFFFFFF);
    case 2: return s_zone_switches;
    case 3: return s_alloc_fail;
    case 4: return (int)s_vbo_verts;
    }
    return -1;
}

char level_code(uint32_t id)
{
    static const char *chars = "0123456789abcdefghijklmnopqrstuvwxyz";
    if (id < 10)
        return chars[id];
    if (id < 36)
        return chars[10 + (id - 10)];
    return '?';
}
