; PICA200 vertex shader for the Crash 3DS port.
;   v0 = vertex position (x, y, z)   - float3
;   v1 = vertex colour  (r, g, b)    - float3

; Uniforms
.fvec projection[4], modelView[4]

; Constants
.constf myconst(0.0, 1.0, -1.0, 0.5)
.alias  ones myconst.yyyy

; Outputs
.out outpos position
.out outclr color
.out outuv texcoord0

; Inputs
.in inpos v0
.in inclr v1
.in inuv v2

.proc main
	; r0 = vec4(inpos, 1.0)
	mov r0.xyz, inpos
	mov r0.w,   ones

	; r1 = modelView * r0
	dp4 r1.x, modelView[0], r0
	dp4 r1.y, modelView[1], r0
	dp4 r1.z, modelView[2], r0
	dp4 r1.w, modelView[3], r0

	; outpos = projection * r1
	dp4 outpos.x, projection[0], r1
	dp4 outpos.y, projection[1], r1
	dp4 outpos.z, projection[2], r1
	dp4 outpos.w, projection[3], r1

	; outclr = vec4(inclr, 1.0)
	mov outuv.xy, inuv.xy
 mov outclr.xyz, inclr.xyz
	mov outclr.w,   ones.x

	end
.end

